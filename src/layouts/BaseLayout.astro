---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Hreflang from "../components/seo/Hreflang.astro";
import Analytics from "../components/seo/Analytics.astro";
import { analyticsEnabled, gaId } from "../lib/analytics";
import { useTranslations, type Lang } from "../lib/i18n/ui";
import { getCanonicalUrl } from "../lib/i18n/routes";
import { ogPageImage } from "../lib/og/pages";
import { brandEmail, brandSameAs, founders } from "../lib/brand";

import HeroBg from "../components/ui/HeroBg.astro";
import Motion from "../components/motion/Motion.astro";
import MotionScript from "../components/motion/MotionScript.astro";

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  lang: Lang;
  /** Path without the /en//es/ prefix, used for canonical + hreflang. e.g. "/" or "/projects/my-project" */
  path: string;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Absolute or site-relative OG/Twitter image. Defaults to the page's card from /og/pages (see src/lib/og/pages.ts). */
  ogImage?: string;
  /** "article" for blog posts and project case studies, "website" (default) otherwise. */
  ogType?: "website" | "article";
  jsonLd?: object;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  /**
   * Path of this page in each language when the slugs differ (blog posts).
   * Defaults to `path` in every locale.
   */
  alternatePaths?: Partial<Record<Lang, string>>;
}

const {
  lang,
  path,
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogType = "website",
  jsonLd,
  breadcrumbs,
  noindex = false,
  alternatePaths,
} = Astro.props;

const site = import.meta.env.SITE;
const { t } = useTranslations(lang);
const resolvedCanonical = getCanonicalUrl(path, lang);
const ogImageUrl = new URL(ogImage ?? ogPageImage(path, lang), site).toString();
const ogLocale = lang === "es" ? "es_ES" : "en_US";

// Kept as one minified string: an unformatted inline block reads as such to
// audits, and Prettier would re-expand a <script> body.
const heroDeadline =
  'setTimeout(function(){var h=document.documentElement;h.hasAttribute("data-motion-ready")||h.setAttribute("data-hero-late","")},1200);';

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}/#organization`,
  name: "Wedevs",
  alternateName: "wedevs",
  url: site,
  logo: `${site}/icons/android-chrome-512x512.png`,
  description: t("home.seoDescription"),
  email: brandEmail,
  // Only the country is public; the studio works remotely.
  address: { "@type": "PostalAddress", addressCountry: "VE" },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: brandEmail,
    availableLanguage: ["en", "es"],
  },
  // The founders' profiles are the studio's public presence until the
  // company accounts are confirmed (see brandSameAs).
  sameAs: [...brandSameAs, ...founders.map((f) => f.linkedin)],
  founder: founders.map((f) => ({
    "@type": "Person",
    "@id": `${site}/#${f.id}`,
    name: f.name,
    url: getCanonicalUrl("/about", lang),
    image: `${site}${f.photo}`,
    sameAs: [f.linkedin],
  })),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}/#website`,
  url: site,
  name: "Wedevs",
  inLanguage: lang,
  // Every deploy is a new revision of the site; the footer shows the same date.
  dateModified: new Date().toISOString(),
  publisher: { "@id": `${site}/#organization` },
};

const breadcrumbJsonLd = breadcrumbs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: crumb.name,
        item: new URL(crumb.url, site).toString(),
      })),
    }
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />
    <MotionScript />
    <!-- Hero deadline: if the motion bundle has not taken over by then, CSS
         shows the hero (global.css [data-hero-late]) so the largest text
         never waits for JavaScript. Keep in sync with INTRO_BUDGET_MS. -->
    <script is:inline set:html={heroDeadline} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <meta name="robots" content="index,follow,max-image-preview:large" />
      )
    }
    {
      import.meta.env.GSC_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.GSC_VERIFICATION}
        />
      )
    }

    {
      !noindex && (
        <>
          <link rel="canonical" href={resolvedCanonical} />
          <Hreflang path={path} paths={alternatePaths} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={resolvedCanonical} />}
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle || title} />
    <meta property="og:site_name" content="Wedevs" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={ogDescription || description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#0e0f12" />

    <link
      rel="preload"
      href="/fonts/manrope-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <!-- Machine-readable site summary for AI assistants (public/llms.txt). -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <slot name="head" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationJsonLd)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteJsonLd)}
      is:inline
    />
    {
      breadcrumbJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbJsonLd)}
          is:inline
        />
      )
    }
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
          is:inline
        />
      )
    }

    {analyticsEnabled && gaId && <Analytics gaId={gaId} />}
  </head>
  <!-- The GSAP curtain (src/lib/motion/curtain.ts) owns page transitions, so
       the View Transition itself swaps instantly. -->
  <body class="relative flex min-h-screen flex-col" transition:animate="none">
    <a
      href="#main-content"
      class="bg-night text-paper sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:rounded-full focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:no-underline"
    >
      {t("nav.skipToContent")}
    </a>
    <!-- Without JS nothing would ever un-hide the motion targets (see global.css). -->
    <noscript>
      <style>
        [data-reveal],
        [data-reveal-group] > *,
        [data-hero-item],
        [data-hero-column] > svg {
          visibility: visible !important;
        }
        [data-hero-column] {
          clip-path: none !important;
        }
      </style>
    </noscript>
    <slot />
    <Motion />
  </body>
</html>
