---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import PixelGrid from "../components/ui/PixelGrid.astro";
import { getLocalizedPath } from "../lib/i18n/routes";
import { useTranslations, type Lang } from "../lib/i18n/ui";
import { md } from "../lib/utils/md";
import type { CollectionEntry } from "astro:content";

type LangData = CollectionEntry<"projects">["data"]["en"];
type NamedItem = { name: string; reason: string };

interface NavProject {
  href: string;
  title: string;
}

interface RelatedPost {
  href: string;
  title: string;
  date: Date;
}

interface Props {
  lang: Lang;
  path: string;
  data: LangData;
  stack: string[];
  preview_url?: string;
  gallery?: string[];
  coverImage?: string;
  next?: NavProject;
  /** Blog posts whose `relatedProjects` cite this project. */
  relatedPosts: RelatedPost[];
  jsonLd?: object;
}

const {
  lang,
  path,
  data,
  stack,
  gallery,
  coverImage,
  preview_url,
  next,
  relatedPosts,
  jsonLd,
} = Astro.props;
const { t } = useTranslations(lang);
const home = getLocalizedPath("/", lang);
const dateFormatter = new Intl.DateTimeFormat(
  lang === "es" ? "es-ES" : "en-US",
  { year: "numeric", month: "long", day: "numeric" },
);
const heroImage = coverImage ?? gallery?.[0];
const projectSlug = path.replace(/^\/projects\//, "");
const ogImage = `/og/projects/${projectSlug}-${lang}.jpg`;
const breadcrumbs = [
  { name: t("project.breadcrumbHome"), url: getLocalizedPath("/", lang) },
  {
    name: t("project.breadcrumbProjects"),
    url: getLocalizedPath("/projects", lang),
  },
  { name: data.title, url: getLocalizedPath(path, lang) },
];

type Section =
  | { id: string; label: string; kind: "prose" | "callout"; body: string }
  | {
      id: string;
      label: string;
      kind: "rows" | "cards" | "results";
      items: NamedItem[];
    }
  | { id: string; label: string; kind: "gallery"; images: string[] };

const sections = (
  [
    data.context && {
      id: "context",
      label: t("project.sectionContext"),
      kind: "prose",
      body: data.context,
    },
    data.conditions && {
      id: "conditions",
      label: t("project.sectionConditions"),
      kind: "callout",
      body: data.conditions,
    },
    data.solution && {
      id: "solution",
      label: t("project.sectionSolution"),
      kind: "prose",
      body: data.solution,
    },
    data.tools?.length && {
      id: "tools",
      label: t("project.sectionTools"),
      kind: "rows",
      items: data.tools,
    },
    data.features?.length && {
      id: "features",
      label: t("project.sectionFeatures"),
      kind: "cards",
      items: data.features,
    },
    data.results?.length && {
      id: "results",
      label: t("project.sectionResults"),
      kind: "results",
      items: data.results,
    },
    gallery?.length && {
      id: "gallery",
      label: t("project.sectionGallery"),
      kind: "gallery",
      images: gallery,
    },
  ] as const
).filter(Boolean) as Section[];

import { itemIndex } from "../lib/utils/itemIndex";
const meta = [
  { label: t("project.client"), value: data.client },
  { label: t("project.role"), value: data.role },
  { label: t("project.period"), value: data.period },
];
const sectionLabel =
  "text-slate font-mono text-xs font-medium tracking-[0.12em] uppercase";
const bodyText =
  "m-0 max-w-[760px] text-lead text-pretty text-ink-prose [&_strong]:text-night [&_strong]:font-semibold";
---

<BaseLayout
  lang={lang}
  path={path}
  title={data.seoTitle ?? `${data.title} Wedevs`}
  description={data.seoDescription ?? data.resultHeadline}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <SiteHeader lang={lang} path={path} />

  <main id="main-content" class="bg-paper text-night">
    <section
      class="bg-night text-paper relative flex flex-col gap-[clamp(40px,6vw,88px)] overflow-hidden px-[clamp(20px,4vw,56px)] pt-7 pb-[clamp(40px,5vw,72px)]"
      data-page-hero
    >
      <PixelGrid cols={24} rows={24} seed={7} hi={0.05} lo={0.015} cover glow />

      <nav
        class="text-fog relative flex flex-wrap gap-2.5 font-mono text-xs"
        aria-label="Breadcrumb"
        data-hero-item
        data-hero-eyebrow
      >
        <a href={home} class="text-fog hover:text-paper no-underline">
          {t("project.breadcrumbHome")}
        </a>
        <span>/</span>
        <a
          href={getLocalizedPath("/projects", lang)}
          class="text-fog hover:text-paper no-underline"
        >
          {t("project.breadcrumbProjects")}
        </a>
        <span>/</span>
        <span class="text-paper">{data.title}</span>
      </nav>

      <div class="relative flex flex-col gap-6">
        <span
          class="self-start rounded-full border border-[rgba(250,250,247,0.3)] px-[11px] py-[5px] text-xs"
          data-hero-item
          data-hero-fade
        >
          {t("project.client")} · {data.client}
        </span>
        <h1
          class="text-paper m-0 text-[clamp(52px,11vw,168px)] leading-[0.88] font-extrabold tracking-[-0.06em] text-balance"
          data-hero-item
          data-hero-title
        >
          {data.title}
        </h1>
        <p
          class="text-night-copy m-0 max-w-[720px] text-[clamp(18px,1.8vw,22px)] leading-normal text-pretty"
          data-hero-item
          data-hero-fade
        >
          {data.summary ?? data.resultHeadline}
        </p>
        {
          preview_url && (
            <div class="flex flex-wrap gap-2.5" data-hero-item data-hero-fade>
              <a
                href={preview_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-night hover:text-violet rounded-full bg-white px-5 py-3 text-sm font-bold no-underline"
              >
                {t("project.viewDemo")}
              </a>
            </div>
          )
        }
      </div>

      <dl
        class="relative m-0 grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-x-8 gap-y-5 border-t border-[rgba(250,250,247,0.18)] pt-6"
        data-hero-item
        data-hero-fade
      >
        {
          meta.map((item) => (
            <div class="flex flex-col gap-1.5">
              <dt class="text-fog text-micro font-mono font-medium tracking-[0.1em] uppercase">
                {item.label}
              </dt>
              <dd class="m-0 font-semibold">{item.value}</dd>
            </div>
          ))
        }
        <div class="flex flex-col gap-1.5">
          <dt
            class="text-fog text-micro font-mono font-medium tracking-[0.1em] uppercase"
          >
            {t("project.stack")}
          </dt>
          <dd class="m-0 flex flex-wrap gap-[5px]">
            {
              stack.map((item) => (
                <span class="bg-night-2 text-micro rounded px-2 py-1 font-mono text-[#d4d6de]">
                  {item}
                </span>
              ))
            }
          </dd>
        </div>
      </dl>
    </section>

    {
      heroImage && (
        <section
          class="px-[clamp(20px,4vw,56px)] pt-[clamp(20px,4vw,56px)]"
          data-reveal
        >
          <img
            src={heroImage}
            alt={`${data.title} cover`}
            width="1600"
            height="686"
            loading="eager"
            decoding="async"
            class="aspect-[21/9] w-full rounded-md object-cover"
          />
        </section>
      )
    }

    {
      sections.length > 0 && (
        <section class="grid grid-cols-1 items-start gap-x-14 gap-y-8 px-[clamp(20px,4vw,56px)] py-[clamp(40px,5vw,72px)] md:grid-cols-[1fr_2fr_1fr]">
          <nav
            class="sticky top-5 hidden flex-col md:flex"
            aria-label="Section index"
          >
            {sections.map((s, i) => (
              <a
                href={`#${s.id}`}
                data-index-link={s.id}
                class="index-link text-slate hover:text-night flex items-baseline gap-3 border-l-2 border-[rgba(17,18,22,0.12)] py-2.5 pl-3.5 text-sm font-medium no-underline"
              >
                <span class="text-violet text-micro font-mono">
                  {itemIndex("02", i)}
                </span>
                {s.label}
              </a>
            ))}
          </nav>
          <nav
            class="flex flex-wrap gap-1.5 md:hidden"
            aria-label="Section index"
          >
            {sections.map((s) => (
              <a
                href={`#${s.id}`}
                data-index-link={s.id}
                class="index-chip bg-paper-3 text-night text-caption rounded-full px-3 py-[7px] no-underline"
              >
                {s.label}
              </a>
            ))}
          </nav>

          <div class="flex min-w-0 flex-col gap-[clamp(56px,7vw,96px)] md:col-start-2">
            {sections.map((s, i) => {
              const label = `${itemIndex("02", i)} · ${s.label}`;
              if (s.kind === "results") {
                return (
                  <article
                    id={s.id}
                    class="bg-violet relative flex scroll-mt-5 flex-col gap-6 overflow-hidden rounded-md p-[clamp(24px,3.5vw,44px)] text-white"
                    data-reveal
                  >
                    <PixelGrid
                      cols={16}
                      rows={14}
                      seed={41}
                      hi={0.04}
                      lo={0.02}
                      color="#fff"
                    />
                    <h2 class="relative m-0 font-mono text-xs font-medium tracking-[0.12em] text-white uppercase">
                      {label}
                    </h2>
                    <div class="relative grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-6">
                      {s.items.map((item) => (
                        <div class="flex flex-col gap-2 border-t border-white/35 pt-3.5">
                          <h3 class="m-0 text-[clamp(22px,2.4vw,30px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white">
                            {item.name}
                          </h3>
                          <p
                            class="m-0 text-sm leading-[1.5] text-white [&_strong]:text-white"
                            set:html={md(item.reason)}
                          />
                        </div>
                      ))}
                    </div>
                  </article>
                );
              }
              return (
                <article
                  id={s.id}
                  class="flex scroll-mt-5 flex-col gap-[18px]"
                  data-reveal
                >
                  <h2 class={`${sectionLabel} m-0`}>{label}</h2>
                  {s.kind === "prose" && (
                    <p class={bodyText} set:html={md(s.body)} />
                  )}
                  {s.kind === "callout" && (
                    <p
                      class={`${bodyText} bg-paper-3 max-w-[820px] rounded-md p-[clamp(20px,3vw,32px)]`}
                      set:html={md(s.body)}
                    />
                  )}
                  {s.kind === "rows" && (
                    <div class="flex flex-col">
                      {s.items.map((item) => (
                        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-8 gap-y-2 border-t border-[rgba(17,18,22,0.12)] py-[18px]">
                          <h3 class="text-night m-0 text-lg font-bold tracking-[-0.015em]">
                            {item.name}
                          </h3>
                          <p
                            class="text-slate [&_strong]:text-night m-0 text-[15px] leading-[1.55] [&_strong]:font-semibold"
                            set:html={md(item.reason)}
                          />
                        </div>
                      ))}
                    </div>
                  )}
                  {s.kind === "cards" && (
                    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-x-8 gap-y-7">
                      {s.items.map((item) => (
                        <div class="border-night flex flex-col gap-2 border-t-2 pt-3.5">
                          <h3 class="text-night m-0 text-lg font-bold tracking-[-0.02em]">
                            {item.name}
                          </h3>
                          <p
                            class="text-slate [&_strong]:text-night m-0 text-[15px] leading-[1.55] [&_strong]:font-semibold"
                            set:html={md(item.reason)}
                          />
                        </div>
                      ))}
                    </div>
                  )}
                  {s.kind === "gallery" && (
                    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))] gap-3">
                      {s.images.map((src, j) => (
                        <button
                          type="button"
                          class="lightbox-trigger block cursor-zoom-in overflow-hidden rounded-md"
                          data-index={j}
                        >
                          <img
                            src={src}
                            alt={`${data.title} screenshot ${j + 1}`}
                            width="800"
                            height="600"
                            loading="lazy"
                            decoding="async"
                            class="aspect-[4/3] w-full object-cover"
                          />
                        </button>
                      ))}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      )
    }

    {
      gallery?.length ? (
        <div
          id="lightbox"
          class="fixed inset-0 z-[60] hidden items-center justify-center bg-[rgba(10,10,9,0.94)] backdrop-blur-sm"
          role="dialog"
          aria-modal="true"
        >
          <button
            id="lightbox-close"
            type="button"
            class="text-paper absolute top-6 right-6 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/25"
            aria-label={t("project.lightboxClose")}
          >
            ✕
          </button>
          <button
            id="lightbox-prev"
            type="button"
            class="text-paper absolute left-6 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/25"
            aria-label={t("project.lightboxPrevious")}
          >
            ←
          </button>
          {/* The enlarged <img> is created by the script from the clicked
               gallery image, so no image element ships without a source. */}
          <span id="lightbox-stage" class="contents" />
          <button
            id="lightbox-next"
            type="button"
            class="text-paper absolute right-6 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/25"
            aria-label={t("project.lightboxNext")}
          >
            →
          </button>
        </div>
      ) : null
    }

    {
      relatedPosts.length > 0 && (
        <section
          class="bg-paper border-t border-[rgba(17,18,22,0.12)] px-[clamp(20px,4vw,56px)] py-[clamp(48px,6vw,88px)]"
          aria-labelledby="related-posts-heading"
          data-reveal-group
        >
          <h2
            id="related-posts-heading"
            class="text-slate m-0 mb-6 font-mono text-xs font-medium tracking-[0.1em] uppercase"
          >
            {t("project.relatedPostsHeading")}
          </h2>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-3">
            {relatedPosts.map((post) => (
              <a
                href={post.href}
                class="bg-night text-paper hover:text-paper relative flex min-h-[200px] flex-col justify-between gap-8 overflow-hidden rounded-[20px] p-[clamp(24px,3vw,40px)] no-underline"
              >
                <PixelGrid cols={12} rows={6} seed={53} hi={0.05} lo={0.015} />
                <span class="relative text-[clamp(22px,2.4vw,28px)] leading-[1.15] font-bold tracking-[-0.03em] text-balance">
                  {post.title}
                </span>
                <span class="text-caption relative flex items-center justify-between gap-3 text-[#a3a7b3]">
                  <time datetime={post.date.toISOString()}>
                    {dateFormatter.format(post.date)}
                  </time>
                  <span class="text-violet-soft font-semibold">→</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      next && (
        <a
          href={next.href}
          class="bg-paper text-night hover:bg-paper-2 hover:text-night grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] border-t border-[rgba(17,18,22,0.12)] no-underline"
        >
          <span class="text-slate px-[clamp(20px,4vw,56px)] py-[clamp(28px,4vw,48px)] font-mono text-xs font-medium tracking-[0.1em] uppercase">
            {t("project.nextCase")}
          </span>
          <span class="col-span-2 flex min-w-0 items-center justify-between gap-4 px-[clamp(20px,4vw,56px)] py-[clamp(28px,4vw,48px)] max-[519px]:col-span-1">
            <span class="text-[clamp(26px,3.6vw,48px)] leading-none font-bold tracking-[-0.04em]">
              {next.title}
            </span>
            <span class="text-violet text-[32px]" aria-hidden="true">
              →
            </span>
          </span>
        </a>
      )
    }
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .index-link.is-active {
    color: var(--color-night);
    font-weight: 700;
    border-color: var(--color-violet);
  }
  .index-chip.is-active {
    background: var(--color-night);
    color: var(--color-paper);
  }
</style>

<script>
  import { initSectionIndex } from "../lib/sectionIndex";

  function initProjectPage() {
    initSectionIndex();

    const lightbox = document.getElementById("lightbox");
    const lightboxStage = document.getElementById("lightbox-stage");
    const triggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".lightbox-trigger"),
    );
    if (lightbox && lightboxStage && triggers.length) {
      let current = 0;
      const lightboxImage = document.createElement("img");
      lightboxImage.id = "lightbox-image";
      lightboxImage.className =
        "max-h-[80vh] max-w-[88vw] rounded-md object-contain";
      lightboxStage.replaceChildren(lightboxImage);

      function show(i: number) {
        current = (i + triggers.length) % triggers.length;
        const img = triggers[current].querySelector("img");
        if (img) {
          lightboxImage!.src = img.src;
          lightboxImage!.alt = img.alt;
        }
      }
      function open(i: number) {
        show(i);
        lightbox!.classList.remove("hidden");
        lightbox!.classList.add("flex");
        document.body.style.overflow = "hidden";
      }
      function close() {
        lightbox!.classList.add("hidden");
        lightbox!.classList.remove("flex");
        document.body.style.overflow = "";
      }

      triggers.forEach((trigger, i) =>
        trigger.addEventListener("click", () => open(i)),
      );
      document
        .getElementById("lightbox-close")
        ?.addEventListener("click", close);
      document
        .getElementById("lightbox-prev")
        ?.addEventListener("click", () => show(current - 1));
      document
        .getElementById("lightbox-next")
        ?.addEventListener("click", () => show(current + 1));
      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) close();
      });
      document.addEventListener("keydown", (e) => {
        if (lightbox.classList.contains("hidden")) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") show(current - 1);
        if (e.key === "ArrowRight") show(current + 1);
      });
    }
  }

  initProjectPage();
  document.addEventListener("astro:after-swap", initProjectPage);
</script>
