---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import PixelGrid from "../components/ui/PixelGrid.astro";
import { getLocalizedPath } from "../lib/i18n/routes";
import { blogAuthor } from "../lib/brand";
import { useTranslations, type Lang } from "../lib/i18n/ui";

interface RelatedPost {
  href: string;
  title: string;
  date: Date;
}

interface Props {
  lang: Lang;
  path: string;
  title: string;
  excerpt: string;
  /** Search snippet overrides; fall back to the title and excerpt. */
  seoTitle?: string;
  seoDescription?: string;
  date: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
  coverImage?: string;
  related: RelatedPost[];
  jsonLd?: object;
}

const {
  lang,
  path,
  title,
  excerpt,
  seoTitle,
  seoDescription,
  date,
  updatedDate,
  tags,
  readingTime,
  coverImage,
  related,
  jsonLd,
} = Astro.props;
const { t } = useTranslations(lang);
const home = getLocalizedPath("/", lang);
const blogHome = getLocalizedPath("/blog", lang);

const dateFormatter = new Intl.DateTimeFormat(
  lang === "es" ? "es-ES" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);

// Same id formula as blog/index.astro's post-title transition:name
// (post slug, derived from `path` = `/blog/<slug>`), so card <-> article
// titles morph together.
const postSlug = path.replace(/^\/blog\//, "").replace(/\//g, "-");
const ogImage = `/og/blog/${path.replace(/^\/blog\//, "")}.png`;
const breadcrumbs = [
  { name: t("project.breadcrumbHome"), url: getLocalizedPath("/", lang) },
  { name: t("nav.blog"), url: blogHome },
  { name: title, url: getLocalizedPath(path, lang) },
];
---

<BaseLayout
  lang={lang}
  path={path}
  title={seoTitle ?? `${title} Wedevs`}
  description={seoDescription ?? excerpt}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <div
    id="reading-progress"
    class="bg-violet fixed top-0 left-0 z-[60] h-[2px] w-0"
  >
  </div>

  <SiteHeader lang={lang} path={path} />

  <main id="main-content" class="bg-paper text-night">
    <section
      class="bg-night text-paper relative flex flex-col items-center overflow-hidden px-[clamp(20px,4vw,56px)] pt-7 pb-[clamp(40px,5vw,72px)]"
    >
      <PixelGrid cols={24} rows={16} seed={53} hi={0.05} lo={0.015} />
      <div
        class="relative flex w-full max-w-[880px] flex-col gap-[clamp(40px,6vw,80px)]"
      >
        <nav
          class="text-fog flex flex-wrap gap-2.5 font-mono text-xs"
          aria-label="Breadcrumb"
        >
          <a href={home} class="text-fog hover:text-violet-soft no-underline">
            {t("project.breadcrumbHome")}
          </a>
          <span>/</span>
          <a
            href={blogHome}
            class="text-fog hover:text-violet-soft no-underline"
          >
            {t("nav.blog")}
          </a>
        </nav>

        <div class="flex flex-col gap-6">
          {
            tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span class="text-paper rounded-full border border-white/20 px-[11px] py-[5px] text-xs">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
          <h1
            class="text-paper m-0 text-[clamp(36px,5.6vw,72px)] leading-none font-extrabold tracking-[-0.045em] text-balance"
            transition:name={`post-title-${postSlug}`}
          >
            {title}
          </h1>
          <p class="m-0 max-w-[620px] text-lg leading-[1.55] text-[#c5c8d2]">
            {excerpt}
          </p>
          <div
            class="flex flex-wrap items-center justify-between gap-3 border-t border-white/15 pt-5"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-violet flex size-9 items-center justify-center rounded-full text-[13px] font-extrabold text-white"
                aria-hidden="true"
              >
                {blogAuthor.initials}
              </span>
              <div class="flex flex-col gap-0.5">
                <a
                  href={getLocalizedPath("/about", lang)}
                  rel="author"
                  class="text-paper hover:text-violet-soft text-sm font-semibold no-underline"
                >
                  {blogAuthor.name}
                </a>
                <span class="text-fog font-mono text-xs">
                  <time datetime={date.toISOString()}>
                    {dateFormatter.format(date)}
                  </time>
                  {
                    updatedDate && (
                      <>
                        {" "}
                        · {t("blog.updatedLabel")}{" "}
                        {dateFormatter.format(updatedDate)}
                      </>
                    )
                  }
                  {" "}· {
                    t("blog.readingTime").replace("{n}", String(readingTime))
                  }
                </span>
              </div>
            </div>
            <button
              type="button"
              id="share-button"
              data-copied={t("blog.shareCopied")}
              data-title={title}
              class="text-paper hover:border-paper cursor-pointer rounded-full border border-white/25 bg-transparent px-3.5 py-2 text-[13px] font-semibold"
            >
              {t("blog.share")} ↗
            </button>
          </div>
        </div>
      </div>
    </section>

    {
      coverImage && (
        <section class="px-[clamp(20px,4vw,56px)] pt-[clamp(28px,4vw,48px)]">
          <img
            src={coverImage}
            alt={title}
            width="1600"
            height="686"
            loading="eager"
            decoding="async"
            class="mx-auto aspect-[21/9] w-full max-w-[1200px] rounded-md object-cover"
          />
        </section>
      )
    }

    <section
      class="flex justify-center px-[clamp(20px,4vw,56px)] py-[clamp(40px,5vw,72px)]"
    >
      <div class="flex w-full max-w-[680px] flex-col">
        <article class="prose">
          <slot />
        </article>

        {
          related.length > 0 && (
            <div class="mt-10 flex flex-col gap-3">
              {related.map((post) => (
                <a
                  href={post.href}
                  class="bg-night text-paper hover:text-paper relative flex min-h-[220px] flex-col justify-between gap-8 overflow-hidden rounded-[20px] p-[clamp(24px,3vw,40px)] no-underline"
                >
                  <PixelGrid
                    cols={12}
                    rows={6}
                    seed={53}
                    hi={0.05}
                    lo={0.015}
                  />
                  <div class="relative flex items-center justify-between gap-3">
                    <span class="font-mono text-xs font-medium tracking-[0.12em] text-[#a3a7b3] uppercase">
                      {t("blog.relatedHeading")}
                    </span>
                    <span class="text-violet-soft font-semibold">→</span>
                  </div>
                  <span class="relative text-[clamp(24px,2.8vw,32px)] leading-[1.1] font-bold tracking-[-0.03em] text-balance">
                    {post.title}
                  </span>
                  <span class="relative text-[13px] text-[#a3a7b3]">
                    {dateFormatter.format(post.date)}
                  </span>
                </a>
              ))}
            </div>
          )
        }

        <a
          href={blogHome}
          class="text-violet mt-4 w-fit font-bold no-underline hover:underline"
        >
          {t("blog.backToBlog")}
        </a>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .prose :global(p),
  .prose :global(li) {
    color: #2a2c33;
    font-size: 17px;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 24px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 24px;
    padding-left: 1.25em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    color: var(--color-night);
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .prose :global(h2) {
    margin-top: 56px;
    margin-bottom: 18px;
    padding-top: 24px;
    border-top: 1px solid rgba(17, 18, 22, 0.12);
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.1;
  }

  .prose :global(h3) {
    margin-top: 36px;
    margin-bottom: 14px;
    font-size: 21px;
  }

  .prose :global(strong) {
    color: var(--color-night);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--color-violet);
    padding-left: 24px;
    margin: 32px 0;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
    color: var(--color-night);
  }

  .prose :global(pre) {
    background: var(--color-night);
    border-radius: 6px;
    padding: 16px;
    overflow-x: auto;
    font-size: 13px;
    margin: 32px 0;
  }

  .prose :global(code) {
    background: var(--color-paper-3);
    color: var(--color-violet);
    border-radius: 4px;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .prose :global(pre code) {
    background: none;
    color: #d4d6de;
    padding: 0;
  }

  .prose :global(a) {
    color: var(--color-violet);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(img) {
    width: 100%;
    border-radius: 6px;
    margin: 32px auto 8px;
    display: block;
  }

  .prose :global(.caption) {
    display: block;
    text-align: center;
    color: var(--color-slate);
    font-size: 12px;
    margin-bottom: 24px;
  }
</style>

<script>
  function initReadingProgress() {
    const bar = document.getElementById("reading-progress");
    if (!bar) return;

    function onScroll() {
      const scrollTop = window.scrollY;
      const docHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      bar!.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", onScroll),
      { once: true },
    );
  }

  function initShare() {
    const button = document.getElementById("share-button");
    if (!button) return;
    const label = button.textContent;
    button.addEventListener("click", async () => {
      const url = window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({ title: button.dataset.title, url });
        } catch {
          // The user closed the share sheet.
        }
        return;
      }
      await navigator.clipboard.writeText(url);
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 2000);
    });
  }

  initReadingProgress();
  initShare();
  document.addEventListener("astro:after-swap", () => {
    initReadingProgress();
    initShare();
  });
</script>
