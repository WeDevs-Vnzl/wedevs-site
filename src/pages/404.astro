---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Glow from "../components/ui/Glow.astro";
import { useTranslations, defaultLang } from "../lib/i18n/ui";
import { getLocalizedPath } from "../lib/i18n/routes";

// Astro serves a single static 404.html regardless of locale, so this page
// uses the default language rather than participating in [lang] routing.
const lang = defaultLang;
const { t } = useTranslations(lang);
const home = getLocalizedPath("/", lang);
---

<BaseLayout
  lang={lang}
  path="/404"
  title="404 Wedevs"
  description="Page not found."
  noindex={true}
>
  <Header lang={lang} path="/404" />

  <main
    id="main-content"
    class="relative flex flex-1 items-center justify-center overflow-hidden px-6 py-20 text-center"
  >
    <Glow size="page" />
    <div class="relative mx-auto max-w-lg">
      <p class="text-display-1 text-muted/30 leading-none font-light">404</p>
      <h1 class="text-h1 -mt-6">{t("notFound.title")}</h1>
      <p class="text-muted mt-4">{t("notFound.support")}</p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={home} class="pill-btn-primary">{t("notFound.ctaHome")}</a>
        <a
          href={getLocalizedPath("/projects", lang)}
          class="pill-btn-secondary"
        >
          {t("notFound.ctaProjects")}
        </a>
      </div>

      <div class="mt-12 flex flex-wrap justify-center gap-6 pt-6 text-sm">
        <a
          href={getLocalizedPath("/projects", lang)}
          class="text-muted hover:text-ink no-underline"
        >
          {t("notFound.linkProjects")}
        </a>
        <a
          href={getLocalizedPath("/services", lang)}
          class="text-muted hover:text-ink no-underline"
        >
          {t("notFound.linkServices")}
        </a>
        <a
          href={getLocalizedPath("/blog", lang)}
          class="text-muted hover:text-ink no-underline"
        >
          {t("notFound.linkBlog")}
        </a>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
