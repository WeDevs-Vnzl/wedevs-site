---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/layout/SiteHeader.astro";
import SiteFooter from "../../components/layout/SiteFooter.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import HowSection from "../../components/sections/HowSection.astro";
import ProjectsSection from "../../components/sections/ProjectsSection.astro";
import ServicesTeaserSection from "../../components/sections/ServicesTeaserSection.astro";
import ProofSection from "../../components/sections/ProofSection.astro";

import { brandEmail, brandWhatsapp } from "../../lib/brand";
import { locales, useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";
import { COVER_SIZES, coverSource, coverSrcset } from "../../lib/images/covers";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const { t } = useTranslations(lang);

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

// The showcase cover is the page's first image; preloaded so it never
// reads as a late, lazy LCP candidate (ProjectsSection renders the same srcset).
const showcase = projects[0];
const showcaseCover = showcase && coverSource(showcase) ? showcase.id : null;

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

const [latestPost] = (
  await getCollection("blog", ({ data }) => data.lang === lang)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  // Same entity as the site-wide Organization; this node adds the service details.
  "@id": `${import.meta.env.SITE}/#organization`,
  name: "Wedevs",
  url: import.meta.env.SITE,
  logo: `${import.meta.env.SITE}/icons/android-chrome-512x512.png`,
  description: t("home.seoDescription"),
  areaServed: "Worldwide",
  address: { "@type": "PostalAddress", addressCountry: "VE" },
  email: brandEmail,
  telephone: brandWhatsapp,
  knowsAbout: [
    "Mobile apps",
    "Websites",
    "CRM",
    "Custom software",
    "ERP integrations",
    "Payment integrations",
    "AI automation",
  ],
};
---

<BaseLayout
  lang={lang}
  path="/"
  title={t("home.seoTitle")}
  description={t("home.seoDescription")}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: t("project.breadcrumbHome"), url: getLocalizedPath("/", lang) },
  ]}
>
  {
    showcaseCover && (
      <link
        slot="head"
        rel="preload"
        as="image"
        imagesrcset={coverSrcset(showcaseCover)}
        imagesizes={COVER_SIZES}
        fetchpriority="high"
      />
    )
  }
  <SiteHeader lang={lang} path="/" overlay />

  <main id="main-content" class="bg-paper text-night">
    <HeroSection lang={lang} />

    <ServicesTeaserSection lang={lang} services={services} />
    <ProjectsSection lang={lang} projects={projects} />
    <HowSection lang={lang} />
    <ProofSection lang={lang} post={latestPost} />
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>
