---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import HowSection from "../../components/sections/HowSection.astro";
import ProjectsSection from "../../components/sections/ProjectsSection.astro";
import ServicesTeaserSection from "../../components/sections/ServicesTeaserSection.astro";
import ContactSection from "../../components/sections/ContactSection.astro";

import { brandEmail } from "../../lib/brand";
import { locales, useTranslations, type Lang } from "../../lib/i18n/ui";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const { t } = useTranslations(lang);

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "WedevsVnzla",
  description: t("home.seoDescription"),
  areaServed: "Worldwide",
  email: brandEmail,
  url: import.meta.env.SITE,
  knowsAbout: [
    "Mobile apps",
    "Websites",
    "CRM",
    "Custom software",
    "ERP integrations",
    "Payment integrations",
    "AI automation",
  ],
};
---

<BaseLayout
  lang={lang}
  path="/"
  title={t("home.seoTitle")}
  description={t("home.seoDescription")}
  jsonLd={jsonLd}
>
  <Header lang={lang} path="/" />

  <main id="main-content">
    <HeroSection lang={lang} />

    <ServicesTeaserSection lang={lang} services={services} />
    <ProjectsSection lang={lang} projects={projects} />
    <HowSection lang={lang} />
    <ContactSection lang={lang} labelIndex={4} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
