---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/layout/SiteHeader.astro";
import SiteFooter from "../../../components/layout/SiteFooter.astro";
import PixelGrid from "../../../components/ui/PixelGrid.astro";
import SplitSection from "../../../components/ui/SplitSection.astro";
import FaqList from "../../../components/ui/FaqList.astro";
import { locales, useTranslations, type Lang } from "../../../lib/i18n/ui";
import { getCanonicalUrl, getLocalizedPath } from "../../../lib/i18n/routes";

export async function getStaticPaths() {
  const services = await getCollection("services");
  const projects = await getCollection("projects");
  return locales.flatMap((lang) =>
    services.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { entry, projects },
    })),
  );
}

const { lang } = Astro.params as { lang: Lang };
const { entry, projects } = Astro.props;
const { t } = useTranslations(lang);
const { stack, relatedProjectIds } = entry.data;
const data = entry.data[lang];

const path = `/services/${entry.id}`;
const canonicalUrl = getCanonicalUrl(path, lang);
const servicesHome = getLocalizedPath("/services", lang);

const transitionId = getLocalizedPath(path, lang).replace(/\//g, "-");
const ogImage = `/og/services/${entry.id}-${lang}.png`;
const breadcrumbs = [
  { name: t("project.breadcrumbHome"), url: getLocalizedPath("/", lang) },
  { name: t("services.detail.breadcrumbServices"), url: servicesHome },
  { name: data.title, url: getLocalizedPath(path, lang) },
];

const relatedProjects = (relatedProjectIds ?? [])
  .map((id) => projects.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => !!p);

import { itemIndex } from "../../../lib/utils/itemIndex";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: data.title,
  description: data.seoDescription ?? data.desc,
  provider: { "@id": `${import.meta.env.SITE}/#organization` },
  url: canonicalUrl,
};
---

<BaseLayout
  lang={lang}
  path={path}
  title={data.seoTitle ?? `${data.title} Wedevs`}
  description={data.seoDescription ?? data.desc}
  ogImage={ogImage}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <SiteHeader lang={lang} path={path} />

  <main id="main-content" class="bg-paper text-night">
    <section
      class="bg-night text-paper relative flex flex-col gap-[clamp(40px,6vw,88px)] overflow-hidden px-[clamp(20px,4vw,56px)] pt-7 pb-[clamp(40px,5vw,72px)]"
    >
      <PixelGrid cols={24} rows={24} seed={23} hi={0.05} lo={0.015} />

      <nav
        class="text-fog relative flex flex-wrap gap-2.5 font-mono text-xs"
        aria-label="Breadcrumb"
      >
        <a
          href={getLocalizedPath("/", lang)}
          class="text-fog hover:text-paper no-underline"
        >
          {t("project.breadcrumbHome")}
        </a>
        <span>/</span>
        <a href={servicesHome} class="text-fog hover:text-paper no-underline">
          {t("services.detail.breadcrumbServices")}
        </a>
        <span>/</span>
        <span class="text-paper">{data.title}</span>
      </nav>

      <div class="relative flex flex-col gap-6">
        <h1
          class="text-paper m-0 text-[clamp(48px,9vw,140px)] leading-[0.9] font-extrabold tracking-[-0.06em] text-balance"
          transition:name={`service-title-${transitionId}`}
        >
          {data.title}
        </h1>
        <p
          class="m-0 max-w-[720px] text-[clamp(18px,1.8vw,22px)] leading-normal text-pretty text-[#c5c8d2]"
        >
          {data.problem}
        </p>
      </div>

      <div
        class="relative flex flex-col gap-2 border-t border-[rgba(250,250,247,0.18)] pt-6"
      >
        <span
          class="text-fog font-mono text-[11px] font-medium tracking-[0.1em] uppercase"
        >
          {t("services.detail.stackLabel")}
        </span>
        <div class="flex flex-wrap gap-[5px]">
          {
            stack.map((tech) => (
              <span class="bg-night-2 rounded px-2 py-1 font-mono text-[11px] text-[#d4d6de]">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <SplitSection
      index="01"
      label={t("services.detail.deliverablesLabel")}
      headingId="deliverables-heading"
    >
      <p
        class="m-0 max-w-[760px] text-[clamp(17px,1.5vw,19px)] leading-[1.7] text-pretty text-[#2a2c33]"
      >
        {data.desc}
      </p>
      <div class="flex flex-col" data-reveal-group>
        {
          data.deliverables.map((d, i) => (
            <div class="grid grid-cols-[40px_1fr] items-baseline gap-x-4 border-t border-[rgba(17,18,22,0.12)] py-[18px]">
              <span class="text-violet font-mono text-xs font-medium">
                {itemIndex("01", i)}
              </span>
              <span class="text-night text-lg font-semibold tracking-[-0.015em]">
                {d}
              </span>
            </div>
          ))
        }
      </div>
    </SplitSection>

    {
      relatedProjects.length > 0 && (
        <SplitSection
          index="02"
          label={t("services.detail.relatedLabel")}
          headingId="related-heading"
          class="bg-paper-2"
        >
          <div class="flex flex-col" data-reveal-group>
            {relatedProjects.map((project) => {
              const p = project.data[lang];
              return (
                <a
                  href={getLocalizedPath(`/projects/${project.id}`, lang)}
                  class="group text-night hover:text-night flex flex-col gap-2 border-t border-[rgba(17,18,22,0.12)] py-6 no-underline last:border-b"
                >
                  <span class="text-slate font-mono text-xs tracking-[0.1em] uppercase">
                    {t("project.client")} · {p.client}
                  </span>
                  <span class="flex items-center justify-between gap-4">
                    <span class="group-hover:text-violet text-[clamp(24px,3vw,36px)] leading-[1.1] font-bold tracking-[-0.035em] transition-colors">
                      {p.title}
                    </span>
                    <span class="text-violet text-2xl" aria-hidden="true">
                      →
                    </span>
                  </span>
                  <span class="text-slate text-[15px] leading-[1.55]">
                    {p.resultHeadline}
                  </span>
                </a>
              );
            })}
          </div>
        </SplitSection>
      )
    }

    <SplitSection
      index={relatedProjects.length > 0 ? "03" : "02"}
      label={t("services.detail.faqLabel")}
      headingId="faq-heading"
    >
      <FaqList items={data.faq} />
      <a
        href={servicesHome}
        class="text-violet mt-2 w-fit font-bold no-underline hover:underline"
      >
        {t("services.detail.backLabel")}
      </a>
    </SplitSection>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>
