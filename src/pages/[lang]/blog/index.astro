---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/layout/SiteHeader.astro";
import SiteFooter from "../../../components/layout/SiteFooter.astro";
import PageHero from "../../../components/ui/PageHero.astro";
import PixelGrid from "../../../components/ui/PixelGrid.astro";
import { locales, useTranslations, type Lang } from "../../../lib/i18n/ui";
import { getLocalizedPath } from "../../../lib/i18n/routes";
import { getPostSlug } from "../../../lib/utils/blog";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const { t } = useTranslations(lang);

const posts = (
  await getCollection("blog", ({ data }) => data.lang === lang)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, ...rest] = posts;

const dateFormatter = new Intl.DateTimeFormat(
  lang === "es" ? "es-ES" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);

const readingTime = (body: string) =>
  Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));

const meta = (post: (typeof posts)[number]) =>
  `${dateFormatter.format(post.data.date)} · ${t("blog.readingTime").replace(
    "{n}",
    String(readingTime(post.body ?? "")),
  )}`;

const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
const postHref = (post: (typeof posts)[number]) =>
  getLocalizedPath(`/blog/${getPostSlug(post.id)}`, lang);
const titleTransition = (post: (typeof posts)[number]) =>
  `post-title-${getPostSlug(post.id).replace(/\//g, "-")}`;
---

<BaseLayout
  lang={lang}
  path="/blog"
  title={t("blog.seoTitle")}
  description={t("blog.seoDescription")}
  breadcrumbs={[
    { name: t("project.breadcrumbHome"), url: getLocalizedPath("/", lang) },
    { name: t("nav.blog"), url: getLocalizedPath("/blog", lang) },
  ]}
>
  <SiteHeader lang={lang} path="/blog" />

  <main id="main-content" class="bg-paper text-night">
    <PageHero
      eyebrow={t("blog.eyebrow")}
      titleBold={t("blog.titleBold")}
      titleLight={t("blog.titleLight")}
      support={t("blog.support")}
      seed={3}
    />

    <section
      class="flex flex-col gap-7 px-[clamp(20px,4vw,56px)] pt-[clamp(28px,4vw,56px)] pb-[clamp(56px,8vw,112px)]"
    >
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5" role="group">
            {["", ...tags].map((tag) => (
              <button
                type="button"
                data-tag-filter={tag}
                aria-pressed={tag === "" ? "true" : "false"}
                class="tag-filter text-night cursor-pointer rounded-full border border-[rgba(17,18,22,0.2)] bg-transparent px-3.5 py-2 text-[13px] font-semibold"
              >
                {tag || t("blog.all")}
              </button>
            ))}
          </div>
        )
      }

      {
        featured && (
          <a
            href={postHref(featured)}
            data-tags={featured.data.tags.join("|")}
            class="bg-night text-paper hover:text-paper relative grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] overflow-hidden rounded-md no-underline"
          >
            <PixelGrid cols={24} rows={16} seed={11} hi={0.05} lo={0.015} />
            <div class="relative flex min-h-[clamp(280px,32vw,420px)] flex-col justify-between gap-10 p-[clamp(24px,4vw,56px)]">
              <div class="flex flex-wrap gap-1.5">
                {featured.data.tags.map((tag) => (
                  <span class="rounded-full border border-[rgba(250,250,247,0.25)] px-[11px] py-[5px] text-xs">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex flex-col gap-4">
                <h2
                  class="text-paper m-0 text-[clamp(28px,3.6vw,48px)] leading-[1.05] font-bold tracking-[-0.035em] text-balance"
                  transition:name={titleTransition(featured)}
                >
                  {featured.data.title}
                </h2>
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="text-fog font-mono text-xs">
                    {meta(featured)}
                  </span>
                  <span class="text-violet-soft font-bold">
                    {t("blog.read")} →
                  </span>
                </div>
              </div>
            </div>
            {featured.data.coverImage ? (
              <img
                src={featured.data.coverImage}
                alt={featured.data.title}
                width="1200"
                height="675"
                class="relative h-full min-h-60 w-full object-cover"
                loading="lazy"
              />
            ) : (
              <div
                class="relative min-h-60 bg-[repeating-linear-gradient(135deg,#1b1c22_0_10px,#17181d_10px_20px)]"
                aria-hidden="true"
              />
            )}
          </a>
        )
      }

      {
        rest.length > 0 && (
          <div class="flex flex-col" data-reveal-group>
            {rest.map((post) => (
              <a
                href={postHref(post)}
                data-tags={post.data.tags.join("|")}
                class="group text-night hover:text-night grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-8 gap-y-2 border-b border-[rgba(17,18,22,0.12)] py-6 no-underline"
              >
                <span class="text-slate font-mono text-xs">{meta(post)}</span>
                <span class="col-span-2 flex flex-col gap-1.5 max-[519px]:col-span-1">
                  <span
                    class="group-hover:text-violet text-[clamp(20px,2.2vw,26px)] font-bold tracking-[-0.025em] transition-colors"
                    transition:name={titleTransition(post)}
                  >
                    {post.data.title}
                  </span>
                  <span class="text-slate text-[15px] leading-[1.55]">
                    {post.data.excerpt}
                  </span>
                </span>
              </a>
            ))}
          </div>
        )
      }

      <p class="m-0 font-mono text-[13px] text-[#6a6c74]">{t("blog.soon")}</p>
    </section>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .tag-filter[aria-pressed="true"] {
    background: var(--color-night);
    border-color: var(--color-night);
    color: var(--color-paper);
  }
</style>

<script>
  function initTagFilter() {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"),
    );
    const posts = Array.from(
      document.querySelectorAll<HTMLElement>("[data-tags]"),
    );
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const tag = button.dataset.tagFilter ?? "";
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
        posts.forEach((post) => {
          const tags = post.dataset.tags!.split("|");
          post.hidden = tag !== "" && !tags.includes(tag);
        });
      }),
    );
  }

  initTagFilter();
  document.addEventListener("astro:after-swap", initTagFilter);
</script>
