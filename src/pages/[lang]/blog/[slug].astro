---
import { blogAuthor, founders } from "../../../lib/brand";
import { getCollection, getEntries, render } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import type { Lang } from "../../../lib/i18n/ui";
import { getCanonicalUrl, getLocalizedPath } from "../../../lib/i18n/routes";
import { getPostSlug } from "../../../lib/utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { lang: entry.data.lang, slug: getPostSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Lang; slug: string };
const { Content, headings } = await render(entry);
const author = founders.find((f) => f.id === entry.data.author) ?? blogAuthor;
// The side index follows the post's h2 headings (ids come from rehype-slug).
const sections = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));

const readingTime = Math.max(
  1,
  Math.round((entry.body ?? "").trim().split(/\s+/).length / 200),
);

const related = (
  await getCollection(
    "blog",
    ({ data, id }) => data.lang === lang && id !== entry.id,
  )
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2)
  .map((p) => ({
    href: getLocalizedPath(`/blog/${getPostSlug(p.id)}`, lang),
    title: p.data.title,
    date: p.data.date,
  }));

const relatedRefs = entry.data.relatedProjects ?? [];
const relatedProjects = (await getEntries(relatedRefs))
  .map((project, i) => {
    if (!project) {
      throw new Error(
        `Blog post "${entry.id}" lists relatedProjects "${relatedRefs[i].id}", which is not a file in src/content/projects.`,
      );
    }
    return project;
  })
  .map((project) => ({
    href: getLocalizedPath(`/projects/${project.id}`, lang),
    title: project.data[lang].title,
    client: project.data[lang].client,
  }));

const path = `/blog/${getPostSlug(entry.id)}`;
const canonicalUrl = getCanonicalUrl(path, lang);

// Translations share a translationKey (or, without one, the slug); each
// language keeps its own slug, so hreflang and the language switch need the
// paired path. Without a translation the switch goes to the other blog index.
const keyOf = (post: typeof entry) =>
  post.data.translationKey ?? getPostSlug(post.id);
const alternatePaths = Object.fromEntries(
  (await getCollection("blog", (post) => keyOf(post) === keyOf(entry))).map(
    (post) => [post.data.lang, `/blog/${getPostSlug(post.id)}`],
  ),
) as Partial<Record<Lang, string>>;
const otherLang: Lang = lang === "en" ? "es" : "en";
const otherPath = alternatePaths[otherLang] ?? "/blog";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.seoDescription ?? entry.data.excerpt,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.date).toISOString(),
  author: {
    "@type": "Person",
    "@id": `${import.meta.env.SITE}/#${author.id}`,
    name: author.name,
    url: getCanonicalUrl("/about", lang),
    image: `${import.meta.env.SITE}${author.photo}`,
    sameAs: [author.linkedin],
  },
  publisher: { "@id": `${import.meta.env.SITE}/#organization` },
  inLanguage: lang,
  url: canonicalUrl,
};
---

<BlogLayout
  lang={lang}
  path={path}
  title={entry.data.title}
  excerpt={entry.data.excerpt}
  seoTitle={entry.data.seoTitle}
  seoDescription={entry.data.seoDescription}
  date={entry.data.date}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  readingTime={readingTime}
  author={author}
  sections={sections}
  coverImage={entry.data.coverImage}
  related={related}
  relatedProjects={relatedProjects}
  alternatePaths={alternatePaths}
  otherPath={otherPath}
  jsonLd={jsonLd}
>
  <Content />
</BlogLayout>
