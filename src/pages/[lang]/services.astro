---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/layout/SiteHeader.astro";
import SiteFooter from "../../components/layout/SiteFooter.astro";
import PageHero from "../../components/ui/PageHero.astro";
import PixelGrid from "../../components/ui/PixelGrid.astro";
import SplitSection from "../../components/ui/SplitSection.astro";
import FaqList from "../../components/ui/FaqList.astro";
import { locales, useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const { t, dict } = useTranslations(lang);
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
import { itemIndex } from "../../lib/utils/itemIndex";
---

<BaseLayout
  lang={lang}
  path="/services"
  title={t("services.seoTitle")}
  description={t("services.seoDescription")}
  breadcrumbs={[
    { name: t("project.breadcrumbHome"), url: getLocalizedPath("/", lang) },
    { name: t("services.eyebrow"), url: getLocalizedPath("/services", lang) },
  ]}
>
  <SiteHeader lang={lang} path="/services" />

  <main id="main-content" class="bg-paper text-night">
    <PageHero
      eyebrow={t("services.eyebrow")}
      titleBold={t("services.titleBold")}
      titleLight={t("services.titleLight")}
      support={t("services.support")}
      seed={23}
    />

    <section class="flex flex-col" data-reveal-group>
      {
        services.map((entry, i) => {
          const data = entry.data[lang];
          const href = getLocalizedPath(`/services/${entry.id}`, lang);
          const transitionId = href.replace(/\//g, "-");
          return (
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] border-b border-[rgba(17,18,22,0.12)]">
              <div class="flex flex-col gap-2 px-[clamp(20px,4vw,56px)] pt-[clamp(28px,4vw,56px)] font-mono text-xs font-medium">
                <span class="text-violet">{itemIndex("01", i)}</span>
                <span class="text-slate tracking-[0.1em] uppercase">
                  {entry.data.stack.slice(0, 3).join(" · ")}
                </span>
              </div>
              <a
                href={href}
                class="group text-night hover:text-night col-span-2 grid min-w-0 grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-x-10 gap-y-5 px-[clamp(20px,4vw,56px)] py-[clamp(28px,4vw,56px)] no-underline max-[519px]:col-span-1"
              >
                <div class="flex flex-col gap-3.5">
                  <h2
                    class="text-night group-hover:text-violet m-0 text-[clamp(26px,3.2vw,40px)] leading-[1.05] font-bold tracking-[-0.035em] transition-colors"
                    transition:name={`service-title-${transitionId}`}
                  >
                    {data.title}
                  </h2>
                  <p class="text-slate m-0 text-[15px] leading-[1.6]">
                    {data.desc}
                  </p>
                  <span class="text-violet font-bold">
                    {t("services.detail.viewLabel")} →
                  </span>
                </div>
                <ul class="m-0 flex list-none flex-col p-0">
                  {data.deliverables.map((d) => (
                    <li class="text-graphite border-t border-[rgba(17,18,22,0.1)] py-2.5 text-[15px] first:border-t-0 first:pt-0">
                      <span class="text-violet mr-2">–</span>
                      {d}
                    </li>
                  ))}
                </ul>
              </a>
            </div>
          );
        })
      }
    </section>

    <SplitSection
      index="02"
      label={t("services.processTitle")}
      headingId="process-heading"
      class="bg-paper-2"
    >
      <div
        class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-x-8 gap-y-7"
        data-reveal-group
      >
        {
          dict.services.process.map((step, i) => (
            <div class="border-night flex flex-col gap-2 border-t-2 pt-3.5">
              <span class="text-violet font-mono text-xs font-medium">
                {itemIndex("03", i)}
              </span>
              <h3 class="text-night m-0 text-[19px] font-bold tracking-[-0.02em]">
                {step.title}
              </h3>
              <p class="text-slate m-0 text-[15px] leading-[1.55]">
                {step.desc}
              </p>
            </div>
          ))
        }
      </div>
    </SplitSection>

    <SplitSection
      index="03"
      label={t("services.modalitiesTitle")}
      headingId="modalities-heading"
    >
      <div
        class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-4"
        data-reveal-group
      >
        {
          dict.services.modalities.map((m) => (
            <div
              class:list={[
                "relative flex flex-col gap-4 overflow-hidden rounded-md p-[clamp(24px,3vw,36px)]",
                m.featured ? "bg-violet text-white" : "bg-paper-3 text-night",
              ]}
            >
              {m.featured && (
                <PixelGrid
                  cols={16}
                  rows={14}
                  seed={41}
                  hi={0.04}
                  lo={0.02}
                  color="#fff"
                />
              )}
              <div class="relative flex flex-wrap items-center justify-between gap-3">
                <h3
                  class:list={[
                    "m-0 text-2xl font-bold tracking-[-0.03em]",
                    m.featured ? "text-white" : "text-night",
                  ]}
                >
                  {m.title}
                </h3>
                {m.featured && (
                  <span class="rounded-full border border-white/40 px-[11px] py-[5px] text-xs text-white">
                    {t("services.featuredLabel")}
                  </span>
                )}
              </div>
              <p
                class:list={[
                  "relative m-0 text-[15px] leading-[1.55]",
                  m.featured ? "text-white" : "text-slate",
                ]}
              >
                {m.desc}
              </p>
              <ul class="relative m-0 flex list-none flex-col gap-2 p-0">
                {m.features.map((f) => (
                  <li
                    class:list={[
                      "text-sm",
                      m.featured ? "text-white" : "text-graphite",
                    ]}
                  >
                    <span
                      class={
                        m.featured ? "mr-2 text-white" : "text-violet mr-2"
                      }
                    >
                      –
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </SplitSection>

    <SplitSection
      index="04"
      label={t("services.faqTitle")}
      headingId="faq-heading"
    >
      <FaqList items={dict.services.faq} />
    </SplitSection>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>
