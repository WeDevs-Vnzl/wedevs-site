---
import { getCollection } from "astro:content";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import { locales, type Lang } from "../../../lib/i18n/ui";
import { getCanonicalUrl, getLocalizedPath } from "../../../lib/i18n/routes";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return locales.flatMap((lang) =>
    projects.map((entry, i) => ({
      params: { lang, slug: entry.id },
      props: {
        entry,
        // Wraps around so the last case study still points somewhere.
        nextEntry:
          projects.length > 1 ? projects[(i + 1) % projects.length] : undefined,
      },
    })),
  );
}

const { lang } = Astro.params as { lang: Lang };
const { entry, nextEntry } = Astro.props;
const { stack, coverImage, gallery, preview_url } = entry.data;
const data = entry.data[lang];

const path = `/projects/${entry.id}`;
const canonicalUrl = getCanonicalUrl(path, lang);

const next = nextEntry
  ? {
      href: getLocalizedPath(`/projects/${nextEntry.id}`, lang),
      title: nextEntry.data[lang].title,
    }
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.seoDescription ?? data.resultHeadline,
  author: { "@id": `${import.meta.env.SITE}/#organization` },
  inLanguage: lang,
  url: canonicalUrl,
};
---

<ProjectLayout
  lang={lang}
  path={path}
  data={data}
  stack={stack}
  coverImage={coverImage}
  gallery={gallery}
  preview_url={preview_url}
  next={next}
  jsonLd={jsonLd}
/>
