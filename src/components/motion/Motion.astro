---
// Page-transition curtain (src/lib/motion/curtain.ts) plus the GSAP motion
// lifecycle. The curtain persists across ClientRouter swaps so it can stay
// down while the next page is fetched and swapped in.
const COLUMNS = 6;
---

<div
  class="pointer-events-none fixed inset-0 z-[100] grid grid-cols-6 motion-reduce:hidden"
  aria-hidden="true"
  data-curtain
  transition:persist="page-curtain"
>
  {
    Array.from({ length: COLUMNS }, () => (
      <div class="relative">
        <span
          class="bg-violet absolute inset-0"
          style="transform: scaleY(0)"
          data-curtain-violet
        />
        <span
          class="bg-night absolute -inset-x-px inset-y-0"
          style="transform: scaleY(0)"
          data-curtain-night
        />
      </div>
    ))
  }
  <span
    class="bg-violet absolute inset-0 m-auto size-5 opacity-0"
    data-curtain-mark></span>
</div>

<script>
  import { initPageMotion } from "../../lib/motion/page";

  initPageMotion();
</script>
