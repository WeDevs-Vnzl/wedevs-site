---
// Page-transition curtain (src/lib/motion/curtain.ts). The GSAP motion
// lifecycle boots from MotionScript.astro in <head>. The curtain persists
// across ClientRouter swaps so it can stay down while the next page is
// fetched and swapped in. The mosaic cells are built by curtain.ts on the
// first navigation: over a thousand nodes that no first paint needs.
---

<div
  class="pointer-events-none fixed inset-0 z-[100] motion-reduce:hidden"
  aria-hidden="true"
  data-curtain
  transition:persist="page-curtain"
>
  <svg
    class="absolute inset-0 size-full"
    viewBox="0 0 24 24"
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
    shape-rendering="crispEdges"
    data-curtain-grid></svg>
  <span
    class="bg-violet absolute inset-0 m-auto size-5 opacity-0"
    data-curtain-mark></span>
</div>
