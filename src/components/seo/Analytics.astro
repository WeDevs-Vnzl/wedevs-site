---
interface Props {
  gaId: string;
}
const { gaId } = Astro.props;
---

<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
<script is:inline define:vars={{ gaId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  // define:vars wraps this script in a function scope, so expose gtag
  // explicitly for other scripts (e.g. the contact form's generate_lead event).
  window.gtag = gtag;
  gtag("js", new Date());
  gtag("config", gaId);
</script>
