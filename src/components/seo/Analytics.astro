---
// The gtag stub is defined synchronously so other scripts (the contact
// form's generate_lead event) can call window.gtag at any time; calls queue
// in the dataLayer until the library arrives. The library itself is fetched
// off the critical path: after the page has loaded and the main thread is
// idle, or on the first user interaction, whichever happens first.
//
// The code is kept as one minified string: an unformatted inline block
// reads as such to audits, and Prettier would re-expand a <script> body.
interface Props {
  gaId: string;
}
const { gaId } = Astro.props;

const code = [
  "window.dataLayer=window.dataLayer||[];",
  "function gtag(){dataLayer.push(arguments)}",
  "window.gtag=gtag;",
  'gtag("js",new Date());',
  `gtag("config",${JSON.stringify(gaId)});`,
  'var loaded=false,events=["pointerdown","keydown","touchstart","scroll"];',
  "function loadGtag(){if(loaded)return;loaded=true;",
  "events.forEach(function(n){window.removeEventListener(n,loadGtag)});",
  'var s=document.createElement("script");s.async=true;',
  `s.src="https://www.googletagmanager.com/gtag/js?id="+${JSON.stringify(gaId)};`,
  "document.head.appendChild(s)}",
  "events.forEach(function(n){window.addEventListener(n,loadGtag,{once:true,passive:true})});",
  'function whenIdle(){"requestIdleCallback"in window?requestIdleCallback(loadGtag,{timeout:4000}):setTimeout(loadGtag,1500)}',
  'document.readyState==="complete"?whenIdle():window.addEventListener("load",whenIdle,{once:true});',
].join("");
---

<link rel="preconnect" href="https://www.googletagmanager.com" />
<script is:inline set:html={code} />
