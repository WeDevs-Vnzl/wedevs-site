---
import { getAlternates, getAlternatesFor } from "../../lib/i18n/routes";
import type { Lang } from "../../lib/i18n/ui";

interface Props {
  /** Path without the /en//es/ prefix, e.g. "/" or "/projects/my-project" */
  path: string;
  /** Per-language paths when the slugs differ; overrides `path`. */
  paths?: Partial<Record<Lang, string>>;
}
const { path, paths } = Astro.props;
const alternates = paths ? getAlternatesFor(paths) : getAlternates(path);
const site = import.meta.env.SITE;
---

{
  Object.entries(alternates).map(([hreflang, href]) => (
    <link
      rel="alternate"
      hreflang={hreflang}
      href={new URL(href, site).toString()}
    />
  ))
}
