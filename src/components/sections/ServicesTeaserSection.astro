---
import type { CollectionEntry } from "astro:content";
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";
import { itemIndex } from "../../lib/utils/itemIndex";

interface Props {
  lang: Lang;
  services: CollectionEntry<"services">[];
}
const { lang, services } = Astro.props;
const { t } = useTranslations(lang);
---

<section
  class="bg-paper-2 text-night grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] content-center lg:min-h-[80dvh]"
  aria-labelledby="services-teaser-heading"
>
  <div
    class="flex flex-col gap-2 px-[clamp(20px,4vw,56px)] pt-[clamp(32px,5vw,72px)] font-mono text-xs font-medium"
  >
    <span class="text-violet">01</span>
    <h2
      id="services-teaser-heading"
      class="text-night m-0 text-xs font-medium tracking-[0.1em] uppercase"
    >
      {t("home.servicesTeaserTitle")}
    </h2>
  </div>

  <div
    class="col-span-2 flex min-w-0 flex-col px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] max-[519px]:col-span-1"
    data-reveal-group
  >
    {
      services.map((entry, i) => {
        const href = getLocalizedPath(`/services/${entry.id}`, lang);
        const transitionId = href.replace(/\//g, "-");
        const data = entry.data[lang];
        return (
          <a
            href={href}
            class="group text-night grid grid-cols-[40px_1fr_auto] items-baseline gap-x-5 border-b border-[rgba(17,18,22,0.1)] py-[clamp(20px,2.4vw,32px)] no-underline first:pt-0"
          >
            <span class="text-violet font-mono text-xs font-medium">
              {itemIndex("01", i)}
            </span>
            <div class="flex flex-col gap-2.5">
              <h3
                class="text-night group-hover:text-violet m-0 text-[clamp(22px,2.8vw,36px)] leading-[1.1] font-bold tracking-[-0.035em] transition-colors"
                transition:name={`service-title-${transitionId}`}
              >
                {data.title}
              </h3>
              <p class="text-slate m-0 text-base leading-[1.55]">
                {data.desc}
              </p>
            </div>
            <span
              class="text-lg transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        );
      })
    }
  </div>
</section>
