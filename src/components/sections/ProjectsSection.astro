---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "../ui/ProjectCard.astro";
import SectionLabel from "../ui/SectionLabel.astro";
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";

interface Props {
  lang: Lang;
  projects: CollectionEntry<"projects">[];
}
const { lang, projects } = Astro.props;
const { t } = useTranslations(lang);
// "View all" only earns its place once the home can't show every project.
const visible = projects.slice(0, 4);
---

<section id="projects" class="bg-bg-alt" aria-labelledby="projects-heading">
  <div class="max-w-base mx-auto px-6 py-20 md:py-30">
    <SectionLabel
      index={2}
      label={t("home.sectionLabels.projects")}
      class="mb-4"
    />
    <h2 id="projects-heading" class="text-h2" data-reveal>
      {t("home.workTitle")}
    </h2>
    <p class="text-accent-dim text-body mt-1.5 mb-8">{t("home.workSupport")}</p>
    <div class="flex flex-col gap-3" data-reveal-group>
      {
        visible.map((p) => (
          <ProjectCard
            lang={lang}
            data={p.data[lang]}
            type={p.data.type}
            stack={p.data.stack}
            href={getLocalizedPath(`/projects/${p.id}`, lang)}
          />
        ))
      }
    </div>
    {
      projects.length > visible.length && (
        <a
          href={getLocalizedPath("/projects", lang)}
          class="text-accent mt-6 inline-block text-sm no-underline hover:underline"
        >
          {t("home.viewAllProjects")} →
        </a>
      )
    }
  </div>
</section>
