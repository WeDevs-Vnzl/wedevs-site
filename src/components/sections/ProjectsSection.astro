---
import type { CollectionEntry } from "astro:content";
import PixelGrid from "../ui/PixelGrid.astro";
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";

type Project = CollectionEntry<"projects">;

interface Props {
  lang: Lang;
  projects: Project[];
}
const { lang, projects } = Astro.props;
const { t } = useTranslations(lang);

// The first project gets the showcase; up to three more line up as rows.
// "View all" only earns its place once the home can't show every project.
const [featured, ...rows] = projects.slice(0, 4);
const shownCount = Math.min(projects.length, 4);

const typeLabel = (p: Project) =>
  t(p.data.type === "own" ? "project.typeOwn" : "project.typeClient");
const coverOf = (p: Project) => p.data.coverImage ?? p.data.gallery?.[0];
const hrefOf = (p: Project) => getLocalizedPath(`/projects/${p.id}`, lang);
// Three highlights at most: the showcase sells the case, the page tells it.
const highlights = featured?.data[lang].highlights?.slice(0, 3) ?? [];
---

<section
  id="projects"
  class="bg-night text-paper relative flex flex-col justify-center gap-[clamp(32px,5vw,64px)] overflow-hidden px-[clamp(20px,4vw,56px)] py-[clamp(48px,7vw,96px)] lg:min-h-[80dvh]"
  aria-labelledby="projects-heading"
>
  <PixelGrid cols={24} rows={60} seed={31} hi={0.035} lo={0.01} cover glow />

  <div class="relative flex flex-col gap-2 font-mono text-xs font-medium">
    <span class="text-violet-soft">02</span>
    <h2
      id="projects-heading"
      class="text-paper m-0 text-xs font-medium tracking-[0.1em] uppercase"
    >
      {t("home.sectionLabels.projects")}
    </h2>
  </div>

  {
    featured && (
      <article class="relative grid gap-x-[clamp(32px,5vw,80px)] gap-y-10 lg:grid-cols-[5fr_7fr] lg:items-center">
        <div class="flex flex-col gap-6" data-reveal-group>
          <p class="text-fog m-0 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
            <span class="text-violet-soft">{typeLabel(featured)}</span>
            <span aria-hidden="true">·</span>
            <span>{featured.data[lang].client}</span>
            <span aria-hidden="true">·</span>
            <span>{featured.data[lang].period}</span>
          </p>

          <h3 class="m-0 text-[clamp(40px,5.2vw,76px)] leading-[0.95] font-extrabold tracking-[-0.05em] text-balance">
            <a
              href={hrefOf(featured)}
              class="text-paper hover:text-violet-soft no-underline transition-colors"
            >
              {featured.data[lang].title}
            </a>
          </h3>

          <p class="text-night-copy text-lead m-0 max-w-[480px] text-pretty">
            {featured.data[lang].resultHeadline}
          </p>

          {highlights.length > 0 && (
            <ul class="m-0 flex list-none flex-col p-0">
              {highlights.map((item) => (
                <li class="text-night-copy border-paper/12 flex gap-3 border-t py-3 text-[15px] leading-relaxed">
                  <span
                    class="bg-violet-soft mt-[9px] size-1.5 shrink-0"
                    aria-hidden="true"
                  />
                  {item}
                </li>
              ))}
            </ul>
          )}

          <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href={hrefOf(featured)}
              class="text-paper border-paper/30 hover:border-paper rounded-full border px-5 py-3 text-sm font-semibold no-underline"
            >
              {t("home.viewProject")} ↗
            </a>
            <div class="flex flex-wrap gap-1.5">
              {featured.data.stack.slice(0, 4).map((item) => (
                <span class="bg-night-2 text-micro text-night-copy rounded px-2 py-1 font-mono">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>

        {coverOf(featured) && (
          <a
            href={hrefOf(featured)}
            class="group block min-w-0 lg:-mr-[clamp(20px,4vw,56px)]"
            aria-label={`${featured.data[lang].title} - ${t("home.viewProject")}`}
            data-reveal
          >
            <figure class="border-paper/15 bg-night-2 m-0 overflow-hidden rounded-[20px] border lg:rounded-r-none lg:border-r-0">
              <div
                class="border-paper/10 flex items-center gap-1.5 border-b px-4 py-3"
                aria-hidden="true"
              >
                <span class="border-paper/30 size-2 rounded-full border" />
                <span class="border-paper/30 size-2 rounded-full border" />
                <span class="border-paper/30 size-2 rounded-full border" />
                <span class="text-night-meta text-micro ml-3 truncate font-mono">
                  {featured.data[lang].title}
                </span>
              </div>
              <img
                src={coverOf(featured)}
                width="1844"
                height="931"
                alt=""
                loading="lazy"
                decoding="async"
                class="block w-full transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              />
            </figure>
          </a>
        )}
      </article>
    )
  }

  {
    rows.length > 0 && (
      <div class="relative flex flex-col" data-reveal-group>
        {rows.map((p) => {
          const data = p.data[lang];
          return (
            <a
              href={hrefOf(p)}
              class="text-paper hover:text-paper border-paper/15 hover:bg-paper/3 grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-x-8 gap-y-5 border-t py-7 no-underline transition-colors"
              title={`${data.title} - ${t("home.viewProject")}`}
            >
              <div class="flex flex-col gap-2.5">
                <span class="text-fog font-mono text-xs">
                  <span class="text-violet-soft">{typeLabel(p)}</span> ·{" "}
                  {data.client}
                </span>
                <h3 class="text-paper m-0 text-[clamp(24px,2.6vw,34px)] leading-[1.05] font-bold tracking-[-0.03em]">
                  {data.title} ↗
                </h3>
                <div class="flex flex-wrap gap-1.5">
                  {p.data.stack.slice(0, 4).map((item) => (
                    <span class="bg-night-2 text-micro text-night-copy rounded px-2 py-1 font-mono">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
              <p class="text-fog m-0 text-[15px] leading-relaxed">
                {data.resultHeadline}
              </p>
            </a>
          );
        })}
      </div>
    )
  }

  {
    projects.length > shownCount && (
      <a
        href={getLocalizedPath("/projects", lang)}
        class="text-violet-soft relative w-fit text-sm font-semibold no-underline hover:underline"
      >
        {t("home.viewAllProjects")} →
      </a>
    )
  }
</section>
