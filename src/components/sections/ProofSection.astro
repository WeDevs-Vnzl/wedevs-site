---
import type { CollectionEntry } from "astro:content";
import PixelGrid from "../ui/PixelGrid.astro";
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";
import { getPostSlug } from "../../lib/utils/blog";

interface Props {
  lang: Lang;
  /** Most recent post in the current language, if any. */
  post?: CollectionEntry<"blog">;
}
const { lang, post } = Astro.props;
const { t, dict } = useTranslations(lang);

// The testimonial card stays hidden until a real client quote is added.
const testimonial = dict.home.testimonial;
const hasTestimonial = testimonial.quote.trim().length > 0;

const dateFormatter = new Intl.DateTimeFormat(
  lang === "es" ? "es-ES" : "en-US",
  { year: "numeric", month: "long", day: "numeric" },
);
const readingTime = post
  ? Math.max(1, Math.round((post.body ?? "").trim().split(/\s+/).length / 200))
  : 0;
---

{
  (hasTestimonial || post) && (
    <section
      class="bg-mist grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] content-center gap-6 px-[clamp(20px,5vw,64px)] py-[clamp(64px,9vw,128px)] text-[#0e0f13] lg:min-h-[80dvh]"
      aria-label={hasTestimonial ? testimonial.title : t("home.blogTitle")}
    >
      {hasTestimonial && (
        <figure class="relative m-0 flex min-h-60 flex-col justify-between gap-8 overflow-hidden rounded-[20px] bg-white p-[clamp(24px,3vw,40px)]">
          <PixelGrid
            cols={12}
            rows={12}
            seed={100}
            hi={0.12}
            lo={0.05}
            color="#4f55e8"
          />
          <span class="relative font-mono text-xs font-medium tracking-[0.12em] text-[#5a5e6b] uppercase">
            {testimonial.title}
          </span>
          <blockquote class="relative m-0 text-[clamp(22px,2.4vw,30px)] leading-[1.3] font-semibold tracking-[-0.02em]">
            “{testimonial.quote}”
          </blockquote>
          <figcaption class="relative flexitems-center gap-3.5 font-mono text-xs text-[#5a5e6b]">
            <span
              class="size-11 shrink-0 rounded-[10px] bg-[repeating-linear-gradient(135deg,#dfe2ea_0_6px,#eef0f5_6px_12px)]"
              aria-hidden="true"
            />
            {testimonial.who}
          </figcaption>
        </figure>
      )}

      {post && (
        <a
          href={getLocalizedPath(`/blog/${getPostSlug(post.id)}`, lang)}
          class="relative flex min-h-60 flex-col justify-between gap-8 overflow-hidden rounded-[20px] bg-[#0e0f13] p-[clamp(24px,3vw,40px)] text-[#eef0f5] no-underline hover:text-[#eef0f5]"
        >
          <PixelGrid cols={12} rows={12} seed={53} hi={0.05} lo={0.015} />
          <div class="relative flex items-center justify-between gap-3">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-[#a3a7b3] uppercase">
              {t("home.blogTitle")}
            </span>
            <span class="text-violet-soft font-semibold">
              {t("home.blogAll")} →
            </span>
          </div>
          <h3 class="relative m-0 text-[clamp(24px,2.8vw,36px)] leading-[1.1] font-bold tracking-[-0.03em] text-balance text-[#eef0f5]">
            {post.data.title}
          </h3>
          <div class="relative flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="rounded-full border border-[rgba(238,240,245,0.2)] px-[11px] py-[5px] text-xs">
                  {tag}
                </span>
              ))}
            </div>
            <span class="text-[13px] text-[#a3a7b3]">
              <time datetime={post.data.date.toISOString()}>
                {dateFormatter.format(post.data.date)}
              </time>{" "}
              · {t("blog.readingTime").replace("{n}", String(readingTime))}
            </span>
          </div>
        </a>
      )}
    </section>
  )
}
