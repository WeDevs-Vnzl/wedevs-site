---
/** Wedevs "w/" monogram (brand manual v1, proposal A) with optional wordmark. */
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
  /** Color of the "w" stroke and wordmark. */
  ink?: string;
  /** Color of the slash: violet on paper, soft violet on night surfaces. */
  slash?: string;
}
const {
  size = 28,
  wordmark = true,
  class: className = "",
  ink = "var(--color-ink)",
  slash = "var(--color-violet)",
} = Astro.props;
---

<span class={`inline-flex items-center ${className}`}>
  <svg
    width={size}
    height={Math.round((size * 64) / 68)}
    viewBox="0 0 68 64"
    aria-hidden="true"
    class="shrink-0"
  >
    <polyline
      points="6,16 17,48 28,26 39,48 50,16"
      fill="none"
      stroke={ink}
      stroke-width="6"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-logo-w></polyline>
    <line
      x1="62"
      y1="10"
      x2="54"
      y2="54"
      stroke={slash}
      stroke-width="6"
      stroke-linecap="round"
      data-logo-slash></line>
  </svg>
  {
    wordmark && (
      <span
        class="mt-[0.075rem] font-extrabold tracking-[-0.04em]"
        style={`color: ${ink}`}
      >
        edevs
      </span>
    )
  }
</span>
