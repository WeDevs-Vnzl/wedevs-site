---
import {
  BriefcaseBusiness,
  Mail,
  MessageSquareText,
  User,
  Wallet,
} from "@lucide/astro";
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import Select from "./Select.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, dict } = useTranslations(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const labelClass =
  "text-violet font-mono text-xs font-medium tracking-[0.1em] uppercase";
const fieldClass =
  "text-night placeholder:text-slate/70 hover:border-violet w-full rounded-md border border-[rgba(17,18,22,0.2)] bg-white py-3 pr-4 pl-11 text-[15px] outline-none focus-visible:ring-0 focus-visible:ring-offset-0";
const iconClass =
  "text-slate pointer-events-none absolute left-4 transition-colors";
---

<form
  id="contact-form"
  class="flex flex-col gap-4"
  method="POST"
  action="/api/contact"
  novalidate
>
  <input type="hidden" name="lang" value={lang} />
  <div class="grid sm:grid-cols-2 gap-6">
    <div class="flex flex-col gap-1.5">
      <label for="cf-name" class={labelClass}>
        {t("contactPage.formNameLabel")}
      </label>
      <div class="group relative flex items-center">
        <User
          size={18}
          aria-hidden="true"
          class={`${iconClass} group-hover:text-violet`}
        />
        <input
          id="cf-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder={t("contactPage.formNamePlaceholder")}
          aria-describedby="cf-name-error"
          class={fieldClass}
        />
      </div>
      <p
        id="cf-name-error"
        class="text-sm text-red-700 empty:hidden"
        role="alert"
      >
      </p>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="cf-email" class={labelClass}>
        {t("contactPage.formEmailLabel")}
      </label>
      <div class="group relative flex items-center">
        <Mail
          size={18}
          aria-hidden="true"
          class={`${iconClass} group-hover:text-violet`}
        />
        <input
          id="cf-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={t("contactPage.formEmailPlaceholder")}
          aria-describedby="cf-email-error"
          class={fieldClass}
        />
      </div>
      <p
        id="cf-email-error"
        class="text-sm text-red-700 empty:hidden"
        role="alert"
      >
      </p>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="flex flex-col gap-1.5">
      <label for="cf-project-type" class={labelClass}>
        {t("contactPage.formProjectTypeLabel")}
      </label>
      <Select
        id="cf-project-type"
        name="project-type"
        required
        describedBy="cf-project-type-error"
        placeholder={t("contactPage.formProjectTypePlaceholder")}
        options={dict.contactPage.formProjectTypeOptions}
      >
        <BriefcaseBusiness
          size={18}
          aria-hidden="true"
          class={`${iconClass} top-1/2 -translate-y-1/2 group-hover:text-violet`}
        />
      </Select>
      <p
        id="cf-project-type-error"
        class="text-sm text-red-700 empty:hidden"
        role="alert"
      >
      </p>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="cf-budget" class={labelClass}>
        {t("contactPage.formBudgetLabel")}
      </label>
      <Select
        id="cf-budget"
        name="budget"
        placeholder={t("contactPage.formBudgetPlaceholder")}
        options={dict.contactPage.formBudgetOptions}
      >
        <Wallet
          size={18}
          aria-hidden="true"
          class={`${iconClass} top-1/2 -translate-y-1/2 group-hover:text-violet`}
        />
      </Select>
    </div>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="cf-message" class={labelClass}>
      {t("contactPage.formMessageLabel")}
    </label>
    <div class="group relative">
      <MessageSquareText
        size={18}
        aria-hidden="true"
        class={`${iconClass} top-3.5 group-hover:text-violet`}
      />
      <textarea
        id="cf-message"
        name="message"
        rows="3"
        required
        placeholder={t("contactPage.formMessagePlaceholder")}
        aria-describedby="cf-message-error"
        class={`${fieldClass} resize-none`}></textarea>
    </div>
    <p
      id="cf-message-error"
      class="text-sm text-red-700 empty:hidden"
      role="alert"
    >
    </p>
  </div>

  <!-- Honeypot: hidden from sighted users and keyboard focus, but present in the
       DOM so simple bots that fill every field trip it. Off-screen, not
       display:none/visibility:hidden, which some bots detect and skip. -->
  <div
    class="absolute top-auto -left-[9999px] h-px w-px overflow-hidden"
    aria-hidden="true"
  >
    <label for="cf-bot-field">Do not fill this field</label>
    <input
      id="cf-bot-field"
      name="company_website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <!-- Turnstile widget, rendered explicitly by the script below so it also
       appears after ClientRouter navigations. It injects the hidden
       cf-turnstile-response input that the server verifies. -->
  <div
    id="cf-turnstile"
    class="min-h-[65px]"
    data-sitekey={turnstileSiteKey}
    data-language={lang}
  >
  </div>

  <button
    id="cf-submit"
    type="submit"
    class="bg-violet w-full cursor-pointer rounded-full border-0 px-[26px] py-4 font-bold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60 sm:w-fit"
  >
    {t("contactPage.formSubmit")}
  </button>

  <p id="cf-status" class="text-slate text-sm" aria-live="polite" role="status">
  </p>
</form>

<script
  is:inline
  define:vars={{
    i18n: {
      requiredError: t("contactPage.formRequiredError"),
      emailError: t("contactPage.formEmailError"),
      captchaError: t("contactPage.formCaptchaError"),
      submitting: t("contactPage.formSubmitting"),
      submit: t("contactPage.formSubmit"),
      success: t("contactPage.formSuccess"),
      error: t("contactPage.formError"),
    },
  }}
>
  window.__contactFormI18n = i18n;
</script>

<script>
  import {
    submitContactForm,
    isValidEmail,
    getMissingRequiredFields,
  } from "../../lib/utils/form";

  interface Turnstile {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (widgetId?: string) => void;
    remove: (widgetId: string) => void;
  }
  const w = window as Window & {
    turnstile?: Turnstile;
    gtag?: (...args: unknown[]) => void;
  };

  const TURNSTILE_SRC =
    "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
  let turnstileLoading: Promise<Turnstile> | undefined;
  let widgetId: string | undefined;

  // Loads api.js once per session; ClientRouter keeps window state across swaps.
  function loadTurnstile(): Promise<Turnstile> {
    if (w.turnstile) return Promise.resolve(w.turnstile);
    turnstileLoading ??= new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = TURNSTILE_SRC;
      script.async = true;
      script.onload = () =>
        w.turnstile ? resolve(w.turnstile) : reject(new Error("turnstile"));
      script.onerror = () => {
        turnstileLoading = undefined; // allow a retry on the next page
        reject(new Error("turnstile"));
      };
      document.head.appendChild(script);
    });
    return turnstileLoading;
  }

  async function renderTurnstile() {
    const slot = document.getElementById("cf-turnstile");
    if (!slot?.dataset.sitekey) return;
    try {
      const turnstile = await loadTurnstile();
      if (!slot.isConnected) return; // navigated away while loading
      widgetId = turnstile.render(slot, {
        sitekey: slot.dataset.sitekey,
        language: slot.dataset.language,
        theme: "light",
      });
    } catch {
      // Widget unavailable: the server rejects the submit and the user sees
      // the captcha message.
    }
  }

  function removeTurnstile() {
    if (widgetId && w.turnstile) w.turnstile.remove(widgetId);
    widgetId = undefined;
  }

  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    if (!form) return;
    renderTurnstile();

    const i18n = (
      window as unknown as { __contactFormI18n: Record<string, string> }
    ).__contactFormI18n;
    const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement;
    const status = document.getElementById("cf-status")!;
    const requiredFields = ["name", "email", "project-type", "message"];

    function setFieldError(field: string, message: string) {
      const el = document.getElementById(`cf-${field}-error`);
      if (el) el.textContent = message;
    }

    function clearErrors() {
      requiredFields.forEach((field) => setFieldError(field, ""));
    }

    function validate(data: Record<string, string>): boolean {
      clearErrors();
      let valid = true;
      for (const field of getMissingRequiredFields(data, requiredFields)) {
        setFieldError(field, i18n.requiredError);
        valid = false;
      }
      if (data.email && !isValidEmail(data.email)) {
        setFieldError("email", i18n.emailError);
        valid = false;
      }
      return valid;
    }

    async function onSubmit(e: SubmitEvent) {
      e.preventDefault();
      if (form.querySelector<HTMLInputElement>("#cf-bot-field")?.value) return; // honeypot tripped

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries()) as Record<
        string,
        string
      >;

      if (!validate(data)) {
        status.textContent = "";
        return;
      }

      if (!data["cf-turnstile-response"]) {
        status.textContent = i18n.captchaError;
        status.className = "text-sm text-red-700";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = i18n.submitting;
      status.textContent = "";
      status.className = "text-sm";

      try {
        await submitContactForm(formData);
        status.textContent = i18n.success;
        status.className = "text-sm text-green-700";
        form.reset();
        // GA4 conversion; mark generate_lead as a Key event in GA Admin.
        w.gtag?.("event", "generate_lead", { form: "contact", lang: data.lang });
      } catch (err) {
        status.textContent =
          (err as Error).message === "captcha" ? i18n.captchaError : i18n.error;
        status.className = "text-sm text-red-700";
      } finally {
        // Turnstile tokens are single-use: request a fresh one per attempt.
        if (widgetId) w.turnstile?.reset(widgetId);
        submitBtn.disabled = false;
        submitBtn.textContent = i18n.submit;
      }
    }

    form.addEventListener("submit", onSubmit);
  }

  initContactForm();
  document.addEventListener("astro:before-swap", removeTurnstile);
  document.addEventListener("astro:after-swap", initContactForm);
</script>
