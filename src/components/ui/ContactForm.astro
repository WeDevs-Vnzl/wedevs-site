---
import {
  BriefcaseBusiness,
  Mail,
  MessageSquareText,
  User,
  Wallet,
} from "@lucide/astro";
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import Select from "./Select.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, dict } = useTranslations(lang);

const labelClass =
  "text-night font-mono text-xs font-medium tracking-[0.1em] uppercase";
const fieldClass =
  "text-night placeholder:text-slate/70 focus-visible:border-violet w-full rounded-md border border-[rgba(17,18,22,0.2)] bg-white py-3 pr-4 pl-11 text-[15px] outline-none";
const iconClass =
  "text-slate pointer-events-none absolute left-4 transition-colors";
---

<form id="contact-form" class="flex flex-col gap-6" novalidate>
  <div class="grid gap-6">
    <div class="flex flex-col gap-1.5">
      <label for="cf-name" class={labelClass}>
        {t("contactPage.formNameLabel")}
      </label>
      <div class="group relative flex items-center">
        <User
          size={18}
          aria-hidden="true"
          class={`${iconClass} group-focus-within:text-violet`}
        />
        <input
          id="cf-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder={t("contactPage.formNamePlaceholder")}
          aria-describedby="cf-name-error"
          class={fieldClass}
        />
      </div>
      <p
        id="cf-name-error"
        class="text-sm text-red-700 empty:hidden"
        role="alert"
      >
      </p>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="cf-email" class={labelClass}>
        {t("contactPage.formEmailLabel")}
      </label>
      <div class="group relative flex items-center">
        <Mail
          size={18}
          aria-hidden="true"
          class={`${iconClass} group-focus-within:text-violet`}
        />
        <input
          id="cf-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={t("contactPage.formEmailPlaceholder")}
          aria-describedby="cf-email-error"
          class={fieldClass}
        />
      </div>
      <p
        id="cf-email-error"
        class="text-sm text-red-700 empty:hidden"
        role="alert"
      >
      </p>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="flex flex-col gap-1.5">
      <label for="cf-project-type" class={labelClass}>
        {t("contactPage.formProjectTypeLabel")}
      </label>
      <Select
        id="cf-project-type"
        name="project-type"
        required
        describedBy="cf-project-type-error"
        placeholder={t("contactPage.formProjectTypePlaceholder")}
        options={dict.contactPage.formProjectTypeOptions}
      >
        <BriefcaseBusiness
          size={18}
          aria-hidden="true"
          class={`${iconClass} top-1/2 -translate-y-1/2 group-focus-within:text-violet`}
        />
      </Select>
      <p
        id="cf-project-type-error"
        class="text-sm text-red-700 empty:hidden"
        role="alert"
      >
      </p>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="cf-budget" class={labelClass}>
        {t("contactPage.formBudgetLabel")}
      </label>
      <Select
        id="cf-budget"
        name="budget"
        placeholder={t("contactPage.formBudgetPlaceholder")}
        options={dict.contactPage.formBudgetOptions}
      >
        <Wallet
          size={18}
          aria-hidden="true"
          class={`${iconClass} top-1/2 -translate-y-1/2 group-focus-within:text-violet`}
        />
      </Select>
    </div>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="cf-message" class={labelClass}>
      {t("contactPage.formMessageLabel")}
    </label>
    <div class="group relative">
      <MessageSquareText
        size={18}
        aria-hidden="true"
        class={`${iconClass} top-3.5 group-focus-within:text-violet`}
      />
      <textarea
        id="cf-message"
        name="message"
        rows="5"
        required
        placeholder={t("contactPage.formMessagePlaceholder")}
        aria-describedby="cf-message-error"
        class={`${fieldClass} resize-none`}
      ></textarea>
    </div>
    <p
      id="cf-message-error"
      class="text-sm text-red-700 empty:hidden"
      role="alert"
    >
    </p>
  </div>

  <!-- Honeypot: hidden from sighted users and keyboard focus, but present in the
       DOM so simple bots that fill every field trip it. Off-screen, not
       display:none/visibility:hidden, which some bots detect and skip. -->
  <div
    class="absolute top-auto -left-[9999px] h-px w-px overflow-hidden"
    aria-hidden="true"
  >
    <label for="cf-bot-field">Do not fill this field</label>
    <input
      id="cf-bot-field"
      name="bot-field"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <button
    id="cf-submit"
    type="submit"
    class="bg-violet mt-2 w-full cursor-pointer rounded-full border-0 px-[26px] py-4 font-bold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60 sm:w-fit"
  >
    {t("contactPage.formSubmit")}
  </button>

  <p id="cf-status" class="text-slate text-sm" aria-live="polite" role="status">
  </p>
</form>

<script
  is:inline
  define:vars={{
    i18n: {
      requiredError: t("contactPage.formRequiredError"),
      emailError: t("contactPage.formEmailError"),
      submitting: t("contactPage.formSubmitting"),
      submit: t("contactPage.formSubmit"),
      success: t("contactPage.formSuccess"),
      error: t("contactPage.formError"),
    },
  }}
>
  window.__contactFormI18n = i18n;
</script>

<script>
  import {
    submitContactForm,
    isValidEmail,
    getMissingRequiredFields,
  } from "../../lib/utils/form";

  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    if (!form) return;

    const i18n = (
      window as unknown as { __contactFormI18n: Record<string, string> }
    ).__contactFormI18n;
    const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement;
    const status = document.getElementById("cf-status")!;
    const requiredFields = ["name", "email", "project-type", "message"];

    function setFieldError(field: string, message: string) {
      const el = document.getElementById(`cf-${field}-error`);
      if (el) el.textContent = message;
    }

    function clearErrors() {
      requiredFields.forEach((field) => setFieldError(field, ""));
    }

    function validate(data: Record<string, string>): boolean {
      clearErrors();
      let valid = true;
      for (const field of getMissingRequiredFields(data, requiredFields)) {
        setFieldError(field, i18n.requiredError);
        valid = false;
      }
      if (data.email && !isValidEmail(data.email)) {
        setFieldError("email", i18n.emailError);
        valid = false;
      }
      return valid;
    }

    async function onSubmit(e: SubmitEvent) {
      e.preventDefault();
      if (form.querySelector<HTMLInputElement>("#cf-bot-field")?.value) return; // honeypot tripped

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries()) as Record<
        string,
        string
      >;

      if (!validate(data)) {
        status.textContent = "";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = i18n.submitting;
      status.textContent = "";
      status.className = "text-sm";

      try {
        await submitContactForm(data);
        status.textContent = i18n.success;
        status.className = "text-sm text-green-700";
        form.reset();
      } catch {
        status.textContent = i18n.error;
        status.className = "text-sm text-red-700";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = i18n.submit;
      }
    }

    form.addEventListener("submit", onSubmit);
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>
