---
import { brandMailHref as mailHref } from "../../lib/brand";
import Logo from "../brand/Logo.astro";
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";
import MobileMenu from "./MobileMenu.astro";

interface Props {
  lang: Lang;
  /** Path without the /en//es/ prefix, e.g. "/" or "/projects/kairos-cms" */
  path: string;
}
const { lang, path } = Astro.props;
const { t } = useTranslations(lang);
const home = getLocalizedPath("/", lang);

const socials = [{ href: mailHref, label: "Email" }];
---

<header class="fixed inset-x-0 top-4 z-50">
  <div class="max-w-base mx-auto flex items-center justify-between gap-6">
    <nav
      id="nav-pill"
      class="border-line flex items-center gap-2 rounded-full border p-2 pl-4 backdrop-blur-md transition-[background-color,border-color,transform] duration-300"
      style={`transition-timing-function: var(--ease-signature)`}
      aria-label={t("nav.navLabel")}
    >
      <a
        href={home}
        class="text-ink mr-20 text-lg font-medium no-underline [text-shadow:0_1px_10px_rgba(0,0,0,0.7)] hover:no-underline"
        aria-label="Wedevs — Home"
        title="Wedevs — Home"
      >
        <Logo size={26} />
      </a>

      <a
        href={getLocalizedPath("/contact", lang)}
        class="text-ink border-line hover:border-line-strong inline-flex items-center gap-1.5 rounded-full border bg-[rgba(246,245,242,0.08)] px-4 py-2 text-sm no-underline"
        title={t("nav.talk")}
      >
        {t("nav.talk")} ↗
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="text-ink border-line hover:border-line-strong inline-flex items-center gap-1.5 rounded-full border bg-[rgba(246,245,242,0.08)] p-2 text-sm no-underline"
        aria-label={t("nav.menuOpenLabel")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-small text-ink border-line hover:border-line-strong inline-flex items-center rounded-full border bg-[rgba(246,245,242,0.1)] px-2 py-1 text-sm no-underline backdrop-blur-md transition-[background-color,border-color,transform]"
            title={`Wedevs — ${s.label}`}
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<MobileMenu lang={lang} path={path} />

<style>
  #nav-pill.is-scrolled {
    background-color: rgba(14, 15, 18, 0.7);
    border-color: var(--color-line-strong);
    backdrop-filter: blur(12px);
    transform: scale(0.97);
  }
</style>

<script>
  function initHeader() {
    const nav = document.getElementById("nav-pill");
    const toggle = document.getElementById("menu-toggle");
    const closeBtn = document.getElementById("menu-close");
    const panel = document.getElementById("mobile-menu");
    if (!nav || !toggle || !panel) return;

    function onScroll() {
      nav!.classList.toggle("is-scrolled", window.scrollY > 24);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    function openMenu() {
      panel!.classList.add("is-open");
      document.body.style.overflow = "hidden";
      toggle!.setAttribute("aria-expanded", "true");
    }
    function closeMenu() {
      panel!.classList.remove("is-open");
      document.body.style.overflow = "";
      toggle!.setAttribute("aria-expanded", "false");
    }

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) closeMenu();
      else openMenu();
    });
    closeBtn?.addEventListener("click", closeMenu);
    panel
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", onScroll);
      },
      { once: true },
    );
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>
