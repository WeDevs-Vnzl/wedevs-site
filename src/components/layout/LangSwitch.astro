---
import { useTranslations, type Lang } from "../../lib/i18n/ui";
import { getLocalizedPath } from "../../lib/i18n/routes";

interface Props {
  lang: Lang;
  /** Path without the /en//es/ prefix, e.g. "/" or "/projects/kairos-cms" */
  path: string;
}
const { lang, path } = Astro.props;
const { t } = useTranslations(lang);
const otherLang: Lang = lang === "en" ? "es" : "en";
---

<a
  href={getLocalizedPath(path, otherLang)}
  class="text-muted hover:text-ink border-line hover:border-line-strong rounded-full border px-3 py-1 font-mono text-xs no-underline"
  aria-label={t("nav.langSwitchLabel")}
  title={t("nav.langSwitchLabel")}>{t("nav.langSwitch")}</a
>
